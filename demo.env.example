# Copy to demo.env (gitignored), fill in, then: source demo.env
# Used only by the helper scripts on your laptop. AAP gets the same values
# through credentials, never through this file.

# --- AWS (from the Open Environment details page) ---
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_REGION=""

# --- Ansible Automation Platform on ROSA ---
export AAP_HOST=""
export AAP_TOKEN=""
export AAP_JOB_TEMPLATE_ID=""

# --- EDA event stream (docs/04) ---
export EDA_EVENT_STREAM_URL=""
export EDA_EVENT_STREAM_USERNAME=""
export EDA_EVENT_STREAM_PASSWORD=""
export EDA_EVENT_STREAM_HEADER=""
export EDA_EVENT_STREAM_TOKEN=""
export EDA_ACTIVATION_NAME=""

# --- ServiceNow PDI ---
export SN_HOST=""
export SN_USERNAME=""
export SN_PASSWORD=""

# --- Dynatrace ---
export DT_TENANT_URL=""
export DT_API_TOKEN=""
export DT_PAAS_TOKEN=""
