{
  "problem_id": "{{ event()['event.id'] }}",
  "pid": "{{ event()['display_id'] }}",
  "title": "{{ event()['event.name'] }}",
  "state": "{{ 'OPEN' if event()['event.status'] == 'ACTIVE' else 'RESOLVED' }}",
  "severity": "{{ event()['event.category'] }}",
  "impact": "{{ event()['dt.davis.impact_level'] | first }}",
  "impacted_entity": "{{ event()['host.name'] | first }}",
  "url": "",
  "tags": "{{ 'automation:selfheal' if 'demo-selfhealing' in event()['dt.host_group.id'] else '' }}"
}
